# Model provider: groq | anthropic | openai (any OpenAI-compatible server, e.g. Ollama)
BRIEFKASTEN_PROVIDER=groq
GROQ_API_KEY=
# Defaults per provider; uncomment to override.
# Stronger model for supervising, explaining, extracting and drafting; faster one for triage and critique;
# vision model for scans and photos. On Groq, Qwen 3.8 does all three.
# BRIEFKASTEN_MODEL=qwen/qwen3.8-27b
# BRIEFKASTEN_MODEL_FAST=qwen/qwen3.8-27b
# BRIEFKASTEN_MODEL_VISION=qwen/qwen3.8-27b

# For BRIEFKASTEN_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# BRIEFKASTEN_MODEL=claude-sonnet-5-5
# BRIEFKASTEN_MODEL_FAST=claude-haiku-5-5

# For BRIEFKASTEN_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# BRIEFKASTEN_MODEL=qwen2.5:14b

# Who reads scans and photos. Redaction needs text, so the reader sees the unredacted page:
#   ocr          local Tesseract OCR, the image never leaves your machine (default; brew install tesseract tesseract-lang)
#   local_vision a local vision model, e.g. Ollama: ollama pull qwen2.5vl:7b
#   cloud        the provider's vision model; sends the unredacted image (best on poor photos)
BRIEFKASTEN_IMAGE_READER=ocr
# BRIEFKASTEN_VISION_BASE_URL=http://localhost:11434/v1
# BRIEFKASTEN_LOCAL_VISION_MODEL=qwen2.5vl:7b

# Tracing to Langfuse (optional; pip install 'briefkasten[observability]'). Off unless both keys are set.
# Only redacted text is sent, plus a second masking pass. EU cloud by default; point it at a self-hosted Langfuse
# to keep traces on your own machine. BRIEFKASTEN_TRACING=off disables it with the keys present.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Bundesland for public holidays: BW, BY, BE, BB, HB, HH, HE, MV, NI, NW, RP, SL, SN, ST, SH, TH
BRIEFKASTEN_STATE=BW

# Names and addresses to mask before anything reaches a model (semicolon separated). Names after "Herrn"/"Frau",
# labelled names ("Ehefrau: ..."), the name line of an address block, street addresses and birthdates are also
# found automatically; BRIEFKASTEN_AUTO_REDACT=0 turns that off. Listing yourself still helps for unusual layouts.
BRIEFKASTEN_REDACT_TERMS=Max Mustermann;Mustermann;Musterstraße 12

# Used as the sender block when exporting an approved reply
BRIEFKASTEN_SENDER_NAME=Max Mustermann
BRIEFKASTEN_SENDER_ADDRESS=Musterstraße 12\n70173 Stuttgart

# Where runs are stored (contains the placeholder map, keep it private)
BRIEFKASTEN_DATA_DIR=.briefkasten
